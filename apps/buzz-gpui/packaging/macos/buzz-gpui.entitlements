<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The app's executable, under the hardened runtime of a Developer ID build. -->
<plist version="1.0">
<dict>
  <!-- Voice notes record from the microphone. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <!-- GStreamer's ORC compiles audio and video kernels into writable,
       executable memory it maps without MAP_JIT. -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
